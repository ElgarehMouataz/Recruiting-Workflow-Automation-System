# ==============================================================================
# Google Workspace & Automation Configuration
# ==============================================================================
RECRUITING_SHEET_ID=your_google_sheet_id
GOOGLE_CALENDAR_ID=careers@yourcompany.com
HIRING_MANAGER_EMAIL=hiring-manager@yourcompany.com
GMAIL_SEARCH_QUERY=label:careers OR label:applications

# ==============================================================================
# n8n & Server Configuration
# ==============================================================================
N8N_PORT=5678
N8N_PROTOCOL=http
N8N_HOST=localhost
WEBHOOK_URL=http://localhost:5678/
GENERIC_TIMEZONE=America/New_York
N8N_ENFORCE_SETTINGS_FILE_PERMISSIONS=true
